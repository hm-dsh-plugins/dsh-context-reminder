{
  "name": "dsh-context-reminder",
  "version": "0.1.0",
  "description": "Reminds you to compact the conversation when context usage reaches 30%, then every further 10%.",
  "type": "module",
  "author": "Hiro Muraki",
  "license": "GPL-3.0-or-later",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hm-dsh-plugins/dsh-context-reminder.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "context",
    "compaction"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build.mjs --client-only",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}